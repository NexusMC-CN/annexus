{
  "name": "@nexusmc/annexus",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js",
      "require": "./dist/sandbox/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "import": "./dist/foundation.js",
      "require": "./dist/foundation.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./tailwind-config": {
      "types": "./dist/tailwind-config.d.ts",
      "import": "./dist/tailwind-config.js",
      "require": "./dist/tailwind-config.cjs"
    },
    "./icons/v1": {
      "types": "./dist/icons/v1/index.d.ts",
      "import": "./dist/icons/v1/index.js",
      "require": "./dist/icons/v1/index.cjs"
    },
    "./icons/v2": {
      "types": "./dist/icons/v2/index.d.ts",
      "import": "./dist/icons/v2/index.js",
      "require": "./dist/icons/v2/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./layered.css": "./dist/layered.css",
    "./theme.css": "./dist/theme.css",
    "./dist/index.css": "./dist/index.css",
    "./dist/layered.css": "./dist/layered.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "build:astro": "node scripts/build-astro.mjs",
    "dev": "vite --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:package && npm run check:size && npm run check:icons",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@charcoal-ui/foundation": "6.1.0",
    "@charcoal-ui/icons": "6.1.0",
    "@charcoal-ui/tailwind-config": "6.1.0",
    "@charcoal-ui/theme": "6.1.0",
    "@charcoal-ui/utils": "6.1.0"
  },
  "devDependencies": {
    "@astrojs/node": "9.5.5",
    "@astrojs/vue": "5.1.4",
    "@charcoal-ui/react": "6.1.0",
    "@charcoal-ui/react-sandbox": "6.1.0",
    "@charcoal-ui/styled": "6.1.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.14.1",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "astro": "5.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "polished": "^4.3.1",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "react": "^18.3.1",
    "react-aria": "^3.48.0",
    "react-dom": "^18.3.1",
    "react-stately": "^3.46.0",
    "styled-components": "^5.3.11",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.3",
    "vitest": "^3.2.4",
    "vue": "3.5.31",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
